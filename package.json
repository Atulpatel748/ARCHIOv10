{
  "name": "archio",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "shared",
    "client"
  ],
  "engines": {
    "node": "^22.22.2 || ^24.15.0 || >=26.0.0"
  },
  "scripts": {
    "dev": "npm run dev -w client",
    "build": "npm run build -w client",
    "preview": "npm run preview -w client",
    "test": "npm run test -w shared && npm run test -w client",
    "test:e2e": "playwright test",
    "audit:deps": "npm audit --audit-level=moderate",
    "images": "npm run images -w client"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "axe-core": "^4.13.0"
  }
}

# ---------- Contact form (Web3Forms: https://web3forms.com) ----------
# Create an access key for the studio inbox, paste it here, and on Vercel add it under Project Settings > Environment
# Variables (VITE_ variables are baked in at build time, so redeploy after changing it). The key ships to the browser
# by design; restrict it to the site's domain in the Web3Forms dashboard. Without a real key the form shows an error.
VITE_WEB3FORMS_ACCESS_KEY=YOUR_WEB3FORMS_ACCESS_KEY

# When using ngrok: set to the hostname only (no https://, no trailing slash). Vite reads this to allow the host.
# NGROK_HOST=xxxx.ngrok-free.app

# ---------- Client (PUBLIC: everything prefixed VITE_ ships to the browser) ----------
VITE_SITE_URL=http://localhost:5173

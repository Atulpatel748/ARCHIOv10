{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "rewrites": [
    {
      "source": "/projects",
      "destination": "/shell.html"
    },
    {
      "source": "/projects/",
      "destination": "/shell.html"
    },
    {
      "source": "/projects/:slug",
      "destination": "/shell.html"
    },
    {
      "source": "/projects/:slug/",
      "destination": "/shell.html"
    },
    {
      "source": "/services",
      "destination": "/shell.html"
    },
    {
      "source": "/services/",
      "destination": "/shell.html"
    },
    {
      "source": "/about",
      "destination": "/shell.html"
    },
    {
      "source": "/about/",
      "destination": "/shell.html"
    },
    {
      "source": "/contact",
      "destination": "/shell.html"
    },
    {
      "source": "/contact/",
      "destination": "/shell.html"
    },
    {
      "source": "/privacy",
      "destination": "/shell.html"
    },
    {
      "source": "/privacy/",
      "destination": "/shell.html"
    },
    {
      "source": "/terms",
      "destination": "/shell.html"
    },
    {
      "source": "/terms/",
      "destination": "/shell.html"
    },
    {
      "source": "/cookies",
      "destination": "/shell.html"
    },
    {
      "source": "/cookies/",
      "destination": "/shell.html"
    },
    {
      "source": "/projects/dubai-marina-residence",
      "destination": "/shell.html"
    },
    {
      "source": "/projects/dubai-marina-residence/",
      "destination": "/shell.html"
    },
    {
      "source": "/projects/jlt-commercial-interior",
      "destination": "/shell.html"
    },
    {
      "source": "/projects/jlt-commercial-interior/",
      "destination": "/shell.html"
    },
    {
      "source": "/projects/arabian-ranches-2-landscape",
      "destination": "/shell.html"
    },
    {
      "source": "/projects/arabian-ranches-2-landscape/",
      "destination": "/shell.html"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data: https:; font-src 'self'; connect-src 'self' https://api.web3forms.com; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "Referrer-Policy",
          "value": "no-referrer"
        },
        {
          "key": "Cross-Origin-Opener-Policy",
          "value": "same-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=(), payment=(), usb=()"
        },
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=63072000; includeSubDomains"
        }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/(images|brand)/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400, stale-while-revalidate=604800"
        }
      ]
    }
  ]
}

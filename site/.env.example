# Public URL of the production website; use the real HTTPS domain before building/deploying.
NEXT_PUBLIC_SITE_URL=https://your-real-domain.example

# Contact form delivery over SMTP (all five are required for live sending; SMTP_PORT is optional and defaults to 587).
# Use the mail host and port your email provider documents. Gmail and Microsoft 365 want an "app password", not the real password.
# Keep SMTP_PASS only in the hosting provider's environment settings, never in git.
SMTP_HOST=smtp.your-mail-provider.example
SMTP_PORT=587
SMTP_USER=the_mailbox_login@example.com
SMTP_PASS=replace_with_the_mailbox_app_password
CONTACT_TO_EMAIL=the_real_inbox@example.com
# Best if this address belongs to the same mailbox or domain as SMTP_USER, so the mail is less likely to land in spam.
CONTACT_FROM_EMAIL="Archió website <the_mailbox_login@example.com>"
